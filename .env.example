LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
MAX_HTTP_CALLS=20
DEFAULT_MAX_TURNS=40

# Executor model. PROVIDER is openai, anthropic or azure_openai: fill in the lines for that provider and leave the other provider's lines empty.
EXECUTOR__PROVIDER=openai
EXECUTOR__API_KEY=
EXECUTOR__REASONING_EFFORT=
# openai and anthropic:
EXECUTOR__MODEL=
# azure_openai:
EXECUTOR__ENDPOINT=
EXECUTOR__DEPLOYMENT=
EXECUTOR__API_VERSION=

# Judge model, with the same settings:
JUDGE__PROVIDER=openai
JUDGE__API_KEY=
JUDGE__REASONING_EFFORT=
# openai and anthropic:
JUDGE__MODEL=
# azure_openai:
JUDGE__ENDPOINT=
JUDGE__DEPLOYMENT=
JUDGE__API_VERSION=
